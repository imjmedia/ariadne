# Git y IDE
.git
.gitignore
.vscode
*.swp
*.swo
# .cursor except skills copied into frontend ayuda
.cursor/*
!.cursor/skills/
!.cursor/skills/**

# Dependencies (se reinstalan en build)
**/node_modules
**/dist
**/.pnpm-store

# Logs y temporales
*.log
.tmp
.cache

# Tests y artefactos CI (no necesarios en imágenes)
**/coverage
**/.playwright
**/playwright-report
**/test-results
**/__tests__
**/*.spec.ts
**/*.test.ts
frontend/e2e

# Servicios no incluidos en docker-compose producción
services/cartographer
