# Origen del servicio Nest API (proxy a ingest). Sin trailing slash.
# Local: http://localhost:3000
# Producción (mismo dominio que el SPA, Traefik /api → api): https://ariadne.kreoint.mx
# NO uses la URL solo-ingest del MCP (ej. apiariadne…:3002) salvo VITE_API_PATH_PREFIX=off
VITE_API_URL=http://localhost:3000

# Prefijo de rutas HTTP (default /api). Vacío solo si VITE_API_URL es ingest directo.
# VITE_API_PATH_PREFIX=/api

# SSO (opcional). Si no se define VITE_SSO_APPLICATION_ID, la app funciona sin auth.
# VITE_SSO_BASE_URL=https://apisso.grupowib.com.mx/api/v1
# VITE_SSO_APPLICATION_ID=uuid-de-tu-app
# VITE_SSO_FRONTEND_URL=https://sso.grupowib.com.mx
