# ────────────────────────────────────────────────────
# Ariadne — Variables de Entorno Esperadas
# Copia a .env y ajusta según tu entorno
# ────────────────────────────────────────────────────

# ── Core ───────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
BUILD_CACHE_BUST=2
JWT_SECRET=changeme-en-produccion
JWT_EXPIRES=604800
CORS_ORIGIN=https://ariadne.tudominio.com
# Dev Docker (frontend :5173, Vite local :5174): descomenta y usa con docker-compose.dev.yml
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CREDENTIALS_ENCRYPTION_KEY=changeme-32-chars-min

# ── LLM (modelos/URL opcionales; API key solo en Ajustes UI) ─
# Plataforma → Ajustes → Proveedores IA (admin). Persistido cifrado en Postgres.
# Estas vars solo aplican defaults de modelo cuando no hay fila en BD:
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_MODEL=google/gemini-2.0-flash-001
LLM_MODEL_INGEST=google/gemini-2.0-flash-001
ORCHESTRATOR_LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_HTTP_REFERER=https://ariadne.tudominio.com
LLM_APP_TITLE=Ariadne

# ── Embeddings ──────────────────────────────────────
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_EMBEDDING_DIM=1536
EMBEDDING_PROVIDER=openrouter
# Ollama local (EMBEDDING_PROVIDER=ollama; perfil embed-local en docker-compose.dev.yml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Graph artifact (Camino D — bootstrap de equipo) ─
# GRAPH_ARTIFACT_EXPORT_ON_SYNC=1
# GRAPH_ARTIFACT_FORCE_IMPORT=1

# ── FalkorDB ────────────────────────────────────────
FALKOR_SHARD_BY_PROJECT=true
FALKOR_SHARD_BY_DOMAIN=false
FALKOR_AUTO_DOMAIN_OVERFLOW=false
FALKOR_GRAPH_NODE_SOFT_LIMIT=100000

# ── OTP / SMTP ─────────────────────────────────────
OTP_DEV_MODE=true
EMAIL_OTP=admin@tudominio.com
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_USER=no-reply@tudominio.com
SMTP_PASS=
SMTP_FROM=Ariadne <no-reply@tudominio.com>

# ── SSO (opcional) ─────────────────────────────────
VITE_SSO_URL=

# ── Frontend ───────────────────────────────────────
VITE_API_URL=https://ariadne.tudominio.com
# Dev: API en host :3000 (no :4000 ni :3002)
# VITE_API_URL=http://localhost:3000

# ── GitHub (para PR URL support) ───────────────────
GITHUB_TOKEN=ghp_...

# ── DevOps ─────────────────────────────────────────
METRICS_ENABLED=true
CHAT_TELEMETRY_LOG=0
