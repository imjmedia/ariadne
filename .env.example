# ────────────────────────────────────────────────────
# Ariadne — Variables de Entorno (bootstrap)
# Copia a .env y ajusta según tu entorno.
# La mayoría de opciones operativas están en UI: Ajustes → Sistema / Ajustes IA.
# ────────────────────────────────────────────────────

# ── Infraestructura (obligatorias en Docker/K8s) ───
JWT_SECRET=changeme-en-produccion
JWT_EXPIRES=604800
CREDENTIALS_ENCRYPTION_KEY=changeme-32-chars-min

# ── Dev / seguridad (no editables desde UI) ─────────
OTP_DEV_MODE=true
BUILD_CACHE_BUST=2

# ── Frontend (build-time) ───────────────────────────
VITE_API_URL=https://ariadne.tudominio.com
VITE_SSO_URL=
# Dev: VITE_API_URL=http://localhost:3000

# ── Deploy producción (Dokploy) ─────────────────────
# COMPOSE_PARALLEL_LIMIT=3
# COMPOSE_PROJECT_NAME=apps-grupowib-relic-wbaqzm

# ── Opcional: defaults bootstrap si aún no hay fila en BD ─
# Tras primer guardado en Ajustes → Sistema, estas dejan de ser necesarias:
# CORS_ORIGIN, EMAIL_OTP, SMTP_*, SSO_URL, FALKOR_*, METRICS_ENABLED,
# CHAT_TELEMETRY_LOG, CHAT_TWO_PHASE, MODIFICATION_PLAN_MAX_FILES, LLM_* (ver Ajustes IA)
#
# GitHub: credencial en /credentials (provider=github) por repo, o GITHUB_TOKEN/GH_TOKEN en env (PR review).
# Ollama local: OLLAMA_BASE_URL, OLLAMA_EMBED_MODEL (EMBEDDING_PROVIDER=ollama).
